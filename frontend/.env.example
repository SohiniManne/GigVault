# Dev: leave unset to use Vite proxy (/api → http://127.0.0.1:8000).
# Production (Vercel): set to your Render API URL, no trailing slash.
# VITE_API_URL=https://gigvault-api.onrender.com

# Firebase Web SDK (Profile → Firestore sync from browser)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
